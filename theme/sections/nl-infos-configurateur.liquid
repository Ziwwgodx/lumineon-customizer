  .nl-infos h3{font-size:19px;line-height:1.35;font-weight:700;letter-spacing:-.2px;margin:0 0 8px;color:var(--v2-text,#f0f1e8)}
  .nl-infos p{font-size:16px;line-height:1.75;color:var(--v2-muted,#b5b9ad);margin:0 0 12px}
  .nl-infos__lead{max-width:68ch;font-size:17px!important}
  .nl-infos__steps{list-style:none;margin:36px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
  .nl-infos__steps li{border-top:1px solid var(--v2-line,#68735e);padding-top:18px;min-width:0}
  .nl-infos__num{display:block;font-size:13px;font-weight:800;letter-spacing:1px;color:var(--v2-signature,#e8ecdc);margin-bottom:10px}
  .nl-infos__block{margin-top:64px;padding-top:40px;border-top:1px solid var(--v2-line,#68735e)}
  .nl-infos__facts{list-style:none;margin:24px 0 24px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .nl-infos__facts li{background:var(--v2-surface,#1b201b);border:1px solid var(--v2-line,#68735e);border-radius:8px;padding:18px;min-width:0}
  .nl-infos__facts strong{display:block;font-size:22px;line-height:1.3;font-weight:700;color:var(--v2-text,#f0f1e8);margin-bottom:6px}
  .nl-infos__facts span{display:block;font-size:15px;line-height:1.6;color:var(--v2-muted,#b5b9ad)}
  .nl-infos__faq{max-width:860px;margin-top:24px}
  .nl-infos__faq details{border:1px solid var(--v2-line,#68735e);border-radius:8px;background:var(--v2-surface,#1b201b);margin-bottom:10px}
  .nl-infos__faq summary{position:relative;display:block;cursor:pointer;list-style:none;padding:15px 52px 15px 18px;min-height:52px;font-size:16px;line-height:1.5;font-weight:650;color:var(--v2-text,#f0f1e8)}
  .nl-infos__faq summary::-webkit-details-marker{display:none}
