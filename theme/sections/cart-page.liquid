  </div>
</div>

{% if cart.item_count > 0 %}
  <div class="cp-sticky" id="cp-sticky">
    <div class="cp-sticky-l">
      <span>{{ cart.total_price | money }}</span>
      <span>{{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}</span>
    </div>
    <a href="/checkout" class="cp-sticky-btn">Commander</a>
  </div>
{% endif %}

<script>
(function(){
  /* Scroll reveal */
  const obs=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('v');obs.unobserve(e.target)}})},{threshold:.08});
  document.querySelectorAll('.cp-r').forEach(el=>obs.observe(el));

  /* Sticky bar */
  const s=document.getElementById('cp-sticky');
  if(s){const o=new IntersectionObserver(es=>{es.forEach(e=>{s.classList.toggle('show',!e.isIntersecting)})},{threshold:0});
  const t=document.getElementById('cp-cta-main');if(t)o.observe(t)}
})();

let cpB=false;
async function cpUpdate(k,q){if(cpB)return;q=parseInt(q);if(q<0)q=0;cpB=true;
const c=document.querySelector('[data-key="'+k+'"]');if(c)c.style.opacity='.4';
try{const r=await fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:k,quantity:q})});
if(!r.ok)throw 0;if(q===0&&c){c.classList.add('removing');cpMsg('Article supprim\u00e9','ok');setTimeout(()=>location.reload(),400)}
else{cpMsg('Quantit\u00e9 mise \u00e0 jour','ok');setTimeout(()=>location.reload(),300)}}
catch(e){cpMsg('Erreur','err');if(c)c.style.opacity='1'}finally{cpB=false}}

function cpRemove(k){cpUpdate(k,0)}

function cpPromo(){const v=document.getElementById('cp-promo-in').value.trim();
if(!v){cpMsg('Entrez un code','err');return}cpMsg('Code appliqu\u00e9 au checkout','ok');document.getElementById('cp-promo-in').value=''}

function cpMsg(t,type){const c=document.getElementById('cart-messages');const d=document.createElement('div');
const ok=type==='ok';d.style.cssText='padding:.7rem 1rem;border-radius:12px;margin-bottom:.8rem;display:flex;align-items:center;gap:.5rem;font-weight:600;font-size:.85rem;backdrop-filter:blur(12px);border:1px solid '+(ok?'rgba(16,185,129,.15)':'rgba(239,68,68,.15)')+';background:'+(ok?'rgba(16,185,129,.06)':'rgba(239,68,68,.06)')+';color:'+(ok?'#10b981':'#f87171');
d.innerHTML='<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="'+(ok?'M5 13l4 4L19 7':'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z')+'"/></svg><span>'+t+'</span>';
c.appendChild(d);setTimeout(()=>{d.style.opacity='0';d.style.transition='opacity .3s';setTimeout(()=>d.remove(),300)},3500)}

document.querySelectorAll('.cp-qty input').forEach(i=>{i.defaultValue=i.value;
i.addEventListener('blur',function(){const q=parseInt(this.value);if(q!==parseInt(this.defaultValue)){if(q<=0)this.value=this.defaultValue;else cpUpdate(this.dataset.key,q)}})});
</script>

{% schema %}
{
  "name": "Page Panier",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ton Panier" },
    { "type": "checkbox", "id": "show_shipping_progress", "label": "Barre livraison gratuite", "default": true },
    { "type": "number", "id": "shipping_threshold", "label": "Seuil livraison gratuite (centimes)", "default": 10000, "info": "10000 = 100\u20ac" },
    { "type": "checkbox", "id": "show_promo_code", "label": "Champ code promo", "default": true }
  ],
  "blocks": [],
  "presets": [{ "name": "Page Panier", "category": "Cart" }]
}
{% endschema %}
