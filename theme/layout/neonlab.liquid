{%- comment -%}
  Mise en page plein écran du configurateur NeonLab (sans en-tête ni pied de page du thème).
  Généré par scripts/shopify-pack.mjs le 2026-11-09 21:28.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111311">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- capture nl_title -%}{{ page_title }}{%- unless page_title contains shop.name %} | {{ shop.name }}{%- endunless -%}{%- endcapture -%}
    <title>{{ nl_title }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif %}
    <meta name="robots" content="index, follow">
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ nl_title | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
    <meta property="og:image" content="https:{{ 'lnv-brand-logos-avatar-social.png' | asset_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <style>html,body{margin:0;background:#111311;color:#f0f1e8}.nl-boot{min-height:100vh;display:grid;place-content:center;gap:12px;padding:24px;text-align:center;font:400 16px/1.5 system-ui,sans-serif}.nl-boot h1{font:400 32px/1.15 Georgia,serif;margin:0}.nl-boot p{margin:0;color:#b6c1c8}</style>
    {{ content_for_header }}
  </head>
  <body class="nl-shopify">
    {{ content_for_layout }}
    {% render 'ga4-events' %}
  </body>
</html>
