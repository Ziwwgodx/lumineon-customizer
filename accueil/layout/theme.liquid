    <a href="/pages/configurateur" id="floating-cta" style="
      position:fixed; bottom:24px; left:24px; z-index:48;
      display:inline-flex; align-items:center; gap:8px;
      padding:12px 20px; background:linear-gradient(135deg,var(--v2-signature),var(--v2-signature));
      color:var(--v2-text); font-weight:700; font-size:0.85rem; border-radius:999px;
      text-decoration:none; box-shadow:0 4px 20px rgba(var(--v2-bg-rgb),0.35);
      transition:all 0.3s; opacity:0; transform:translateY(20px); pointer-events:none;
    ">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      {{ ln_cta_configurator_label | strip }}
    </a>
    <script>
    (function(){
      var cta=document.getElementById('floating-cta');
      if(!cta)return;
      var shown=false;
      window.addEventListener('scroll',function(){
        var show=window.scrollY>800;
        if(show!==shown){
          shown=show;
          cta.style.opacity=show?'1':'0';
          cta.style.transform=show?'translateY(0)':'translateY(20px)';
          cta.style.pointerEvents=show?'auto':'none';
        }
      },{passive:true});
    })();
    </script>
