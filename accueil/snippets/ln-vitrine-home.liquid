{% render 'ln-vitrine-footer' %}
<script>
(function () {
  // Champ vide : le configurateur s'ouvre sur son exemple. Aperçu de thème : on garde le thème prévisualisé.
  var q = new URLSearchParams(location.search), preview = q.get('preview_theme_id');
  document.querySelectorAll('form.nlh-start').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      var input = f.querySelector('input[name="texte"]');
      var text = input ? input.value.trim() : '';
      var url = new URL(f.getAttribute('action'), location.href);
      if (text) url.searchParams.set('texte', text);
      if (preview && /^\d+$/.test(preview)) { url.searchParams.set('preview_theme_id', preview); url.searchParams.set('pb', '0'); }
      e.preventDefault();
      location.assign(url.href);
    });
  });
})();
</script>
